body {
    font-family: system-ui, -apple-system, sans-serif;
    background-color: #f3f4f6;
    color: #1f2937;
    margin: 0;
    padding: 20px;
    display: flex;
    justify-content: center;
}

.container {
    width: 100%;
    max-width: 600px;
}

header {
    text-align: center;
    margin-bottom: 24px;
}

header h1 {
    margin: 0 0 8px 0;
    color: #2563eb;
}

.card {
    background: #ffffff;
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.content-box {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    padding: 16px;
    border-radius: 8px;
    min-height: 100px;
    margin: 16px 0;
    line-height: 1.5;
    white-space: pre-line;
}

.btn {
    background-color: #2563eb;
    color: white;
    border: none;
    padding: 10px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    width: 100%;
}

.btn:hover {
    background-color: #1d4ed8;
}
